#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>
set -euo pipefail

BUILD_DIR=$(cd "$1" && pwd)
CACHE_DIR=$(cd "$2" && pwd)
ENV_DIR=$3
LP_DIR=$(cd "$(dirname "$0")/.." && pwd)
repo="https://github.com/CoffeeFlux/heroku-buildpack-vips"
version=$(<"$LP_DIR/package-version")

if [[ ${STACK:-} != heroku-24 || $(uname -m) != x86_64 ]]; then
  echo 'vips: this fork requires Heroku-24 x64.' >&2
  exit 1
fi
if [[ -f "$ENV_DIR/VIPS_VERSION" ]]; then
  version=$(<"$ENV_DIR/VIPS_VERSION")
fi
if [[ ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+-r[1-9][0-9]*$ ]]; then
  echo 'vips: VIPS_VERSION must identify a published x.y.z-rN package release.' >&2
  exit 1
fi

vendor="$BUILD_DIR/vendor/vips"
# Do not reuse upstream's cache, even for the same libvips version and stack.
bundle="$CACHE_DIR/vips-coffeeflux/$version/$STACK"
if [[ -e "$vendor" ]]; then
  echo 'vips: vendor/vips already exists; use a clean app build directory.' >&2
  exit 1
fi

echo "-----> vips: Vendoring $version for $STACK"
if [[ ! -f "$bundle/.complete" ]]; then
  if [[ -e "$bundle" ]]; then
    echo 'vips: incomplete cache entry; clear the app build cache and retry.' >&2
    exit 1
  fi
  work=$(mktemp -d "$CACHE_DIR/vips-coffeeflux-download.XXXXXX")
  trap 'rm -rf -- "$work"' EXIT
  url="$repo/releases/download/v$version/$STACK.tar.gz"
  curl --fail --location --silent --show-error --retry 2 --max-time 180 \
    "$url" -o "$work/$STACK.tar.gz"
  curl --fail --location --silent --show-error --retry 2 --max-time 30 \
    "$url.sha256" -o "$work/$STACK.tar.gz.sha256"
  (cd "$work" && sha256sum --check "$STACK.tar.gz.sha256")
  mkdir "$work/payload"
  tar -xzf "$work/$STACK.tar.gz" -C "$work/payload"
  test -f "$work/payload/lib/pkgconfig/vips-cpp.pc"
  test -x "$work/payload/bin/vips"
  touch "$work/payload/.complete"
  mkdir -p "$(dirname "$bundle")"
  mv "$work/payload" "$bundle"
fi

mkdir -p "$vendor"
cp -R "$bundle/." "$vendor/"
# Relocatable pkg-config files replace the application's old prefix-rewrite hook.
# Leave the cached archive unchanged; later Node builds can discover global vips.
find "$vendor/lib/pkgconfig" -name '*.pc' -exec \
  sed -i 's|/usr/local/vips|${pcfiledir}/../..|g' {} +

echo '-----> vips: Building runtime environment'
mkdir -p "$BUILD_DIR/.profile.d"
cat > "$BUILD_DIR/.profile.d/vips.sh" <<'PROFILE'
export PATH="$HOME/vendor/vips/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$HOME/vendor/vips/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
PROFILE

# Build-only discovery paths for the official Node buildpack. No compiler,
# Meson, Ninja or source tree is installed in the app.
export PATH="$vendor/bin${PATH:+:$PATH}"
export LD_LIBRARY_PATH="$vendor/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LIBRARY_PATH="$vendor/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
export INCLUDE_PATH="$vendor/include${INCLUDE_PATH:+:$INCLUDE_PATH}"
export CPATH="$vendor/include${CPATH:+:$CPATH}"
export CPPPATH="$vendor/include${CPPPATH:+:$CPPPATH}"
export PKG_CONFIG_PATH="$vendor/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export | grep -E ' (PATH|LD_LIBRARY_PATH|LIBRARY_PATH|INCLUDE_PATH|CPATH|CPPPATH|PKG_CONFIG_PATH)=' > "$LP_DIR/export"
